# Database (PostgreSQL with pgvector)
# Replace with your local PostgreSQL or Supabase/Neon connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hireflow_ai?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="hireflow-ai-development-super-secret-key-32chars"

# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Free Tier AI API (Google AI Studio)
# Obtain a free key from https://aistudio.google.com/app/apikey (100% Free: 15 RPM, 1M TPM)
GEMINI_API_KEY="your-gemini-api-key"

